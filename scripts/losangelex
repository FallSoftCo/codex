#!/usr/bin/env bash
set -euo pipefail

repo_root="/home/ai/Development/losangelex/codex-rs"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
default_cargo_target_dir="$repo_root/target/losangelex-launcher"
cargo_target_dir="${LOSANGELEX_CARGO_TARGET_DIR:-$default_cargo_target_dir}"
default_binary_path="$cargo_target_dir/debug/codex"
binary_path="${LOSANGELEX_CODEX_BIN:-$default_binary_path}"
launch_cwd="${PWD}"
codex_home="${CODEX_HOME:-$HOME/.codex}"
migration_dir="$codex_home/losangelex"
migration_marker="$migration_dir/migration-v1.json"
workspace_setup_file="$migration_dir/workspace-room-setups-v1.json"
losangelex_email_env="$migration_dir/aws-email.env"
jobsearcher_env="/home/ai/Development/jobsearcher/.env"
aws_credentials_file="${AWS_SHARED_CREDENTIALS_FILE:-$HOME/.aws/credentials}"
app_server_mode="${LOSANGELEX_APP_SERVER_MODE:-daemon}"
app_server_url="${LOSANGELEX_APP_SERVER_URL:-}"
app_server_base_port="${LOSANGELEX_APP_SERVER_BASE_PORT:-46321}"
app_server_state_file="$migration_dir/current-app-server.json"
app_server_generations_dir="$migration_dir/app-servers"
app_server_start_timeout_seconds="${LOSANGELEX_APP_SERVER_START_TIMEOUT_SECONDS:-20}"
restart_handoff_file="$migration_dir/restart-handoff.json"
restart_exit_code="${LOSANGELEX_CLIENT_RESTART_EXIT_CODE:-85}"
is_team_command=0
if [[ "${1:-}" == "team" ]]; then
  is_team_command=1
fi

resolve_binary_path() {
  local requested="$1"
  if [[ "$requested" == */* ]]; then
    printf '%s\n' "$requested"
    return
  fi
  command -v "$requested"
}

ensure_losangelex_binary() {
  if [[ -n "${LOSANGELEX_CODEX_BIN:-}" ]]; then
    if ! binary_path="$(resolve_binary_path "$LOSANGELEX_CODEX_BIN")"; then
      printf 'losangelex configured binary could not be resolved: %s\n' "$LOSANGELEX_CODEX_BIN" >&2
      return 1
    fi
    if [[ ! -x "$binary_path" ]]; then
      printf 'losangelex configured binary is not executable: %s\n' "$binary_path" >&2
      return 1
    fi
    return
  fi

  if [[ "${LOSANGELEX_AUTO_BUILD:-1}" != "0" ]]; then
    (
      cd "$repo_root"
      cargo +stable build --target-dir "$cargo_target_dir" -p codex-cli --bin codex
    )
  fi

  if [[ ! -x "$binary_path" ]]; then
    printf 'losangelex binary is not executable: %s\n' "$binary_path" >&2
    printf 'run with LOSANGELEX_AUTO_BUILD=1 or set LOSANGELEX_CODEX_BIN to an executable codex binary\n' >&2
    return 1
  fi
}

if [[ -z "${AWS_ACCESS_KEY_ID:-}" && -z "${AWS_PROFILE:-}" && -z "${AWS_DEFAULT_PROFILE:-}" && -f "$losangelex_email_env" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$losangelex_email_env"
  set +a
fi

if [[ -z "${AWS_ACCESS_KEY_ID:-}" && -z "${AWS_PROFILE:-}" && -z "${AWS_DEFAULT_PROFILE:-}" && ! -f "$aws_credentials_file" && -f "$jobsearcher_env" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$jobsearcher_env"
  set +a
fi

if [[ -z "${AWS_ACCESS_KEY_ID:-}" && -n "${AWS_SES_ACCESS_KEY:-}" ]]; then
  export AWS_ACCESS_KEY_ID="$AWS_SES_ACCESS_KEY"
fi

if [[ -z "${AWS_DEFAULT_REGION:-}" && -n "${AWS_REGION:-}" ]]; then
  export AWS_DEFAULT_REGION="$AWS_REGION"
fi

slugify_room() {
  local raw="$1"
  local slug
  slug="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//; s/--*/-/g')"
  if [[ -z "$slug" ]]; then
    slug="workspace"
  fi
  printf '%s\n' "$slug"
}

default_primary_room() {
  local cwd="$1"
  local git_root=""
  if git_root="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)"; then
    printf 'repo/%s\n' "$(slugify_room "$(basename "$git_root")")"
    return
  fi

  printf 'main\n'
}

load_persisted_workspace_setup() {
  local file="$1"
  local cwd="$2"
  python3 - "$file" "$cwd" <<'PY'
import json, sys
path, cwd = sys.argv[1], sys.argv[2]
try:
    with open(path, "r", encoding="utf-8") as fh:
        data = json.load(fh)
except Exception:
    sys.exit(0)
setup = (data.get("workspaces") or {}).get(cwd)
if not isinstance(setup, dict):
    sys.exit(0)
print(setup.get("primary_room", "") or "")
print(",".join(setup.get("observed_rooms", []) or []))
print(",".join(setup.get("wake_rooms", []) or []))
PY
}

app_server_ready() {
  local websocket_url="$1"
  python3 - "$websocket_url" <<'PY'
import sys
import urllib.error
import urllib.request

url = sys.argv[1]
if url.startswith("ws://"):
    url = "http://" + url[5:]
elif url.startswith("wss://"):
    url = "https://" + url[6:]
else:
    raise SystemExit(1)
url = url.rstrip("/") + "/readyz"
try:
    with urllib.request.urlopen(url, timeout=1.5) as response:
        raise SystemExit(0 if response.status == 200 else 1)
except Exception:
    raise SystemExit(1)
PY
}

losangelex_app_server_build_id() {
  if [[ -n "${LOSANGELEX_APP_SERVER_BUILD_ID_OVERRIDE:-}" ]]; then
    printf '%s\n' "$LOSANGELEX_APP_SERVER_BUILD_ID_OVERRIDE"
    return
  fi

  if [[ -x "$binary_path" ]]; then
    if command -v sha256sum >/dev/null 2>&1; then
      sha256sum "$binary_path" | awk '{print substr($1, 1, 16)}'
      return
    fi
    if command -v shasum >/dev/null 2>&1; then
      shasum -a 256 "$binary_path" | awk '{print substr($1, 1, 16)}'
      return
    fi
  fi

  git -C "$repo_root" rev-parse --short=16 HEAD 2>/dev/null || date +%s
}

read_app_server_json_websocket_url() {
  local file="$1"
  python3 - "$file" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as fh:
        data = json.load(fh)
except Exception:
    sys.exit(0)
value = data.get("websocket_url")
if isinstance(value, str) and value:
    print(value)
PY
}

write_app_server_state() {
  local file="$1"
  local build_id="$2"
  local websocket_url="$3"
  local pid_file="$4"
  local log_file="$5"

  mkdir -p "$(dirname "$file")"
  cat >"$file" <<JSON
{
  "schema_version": 1,
  "updated_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "build_id": "$build_id",
  "websocket_url": "$websocket_url",
  "pid_file": "$pid_file",
  "log_file": "$log_file"
}
JSON
}

read_restart_handoff_thread_id() {
  local file="$1"
  python3 - "$file" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as fh:
        data = json.load(fh)
except Exception:
    sys.exit(0)
value = data.get("thread_id")
if isinstance(value, str) and value:
    print(value)
PY
}

find_free_loopback_port() {
  local base_port="$1"
  python3 - "$base_port" <<'PY'
import socket, sys
base = int(sys.argv[1])
for port in range(base, base + 200):
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        sock.bind(("127.0.0.1", port))
    except OSError:
        sock.close()
        continue
    sock.close()
    print(port)
    raise SystemExit(0)
raise SystemExit(1)
PY
}

start_losangelex_app_server() {
  local start_timeout="$1"
  local build_id
  build_id="$(losangelex_app_server_build_id)"
  local generation_dir="$app_server_generations_dir/$build_id"
  local generation_metadata_file="$generation_dir/metadata.json"
  local generation_pid_file="$generation_dir/app-server.pid"
  local generation_log_file="$generation_dir/app-server.log"
  local websocket_url

  mkdir -p "$generation_dir"
  websocket_url="$(read_app_server_json_websocket_url "$generation_metadata_file")"
  if [[ -z "$websocket_url" ]]; then
    local port
    port="$(find_free_loopback_port "$app_server_base_port")"
    websocket_url="ws://127.0.0.1:$port"
    write_app_server_state \
      "$generation_metadata_file" \
      "$build_id" \
      "$websocket_url" \
      "$generation_pid_file" \
      "$generation_log_file"
  fi

  if app_server_ready "$websocket_url"; then
    write_app_server_state \
      "$generation_metadata_file" \
      "$build_id" \
      "$websocket_url" \
      "$generation_pid_file" \
      "$generation_log_file"
    write_app_server_state \
      "$app_server_state_file" \
      "$build_id" \
      "$websocket_url" \
      "$generation_pid_file" \
      "$generation_log_file"
    printf '%s\n' "$websocket_url"
    return 0
  fi

  if ! app_server_ready "$websocket_url" && [[ -f "$generation_pid_file" ]]; then
    local existing_pid
    existing_pid="$(<"$generation_pid_file")"
    if [[ -n "$existing_pid" ]] && kill -0 "$existing_pid" 2>/dev/null; then
      printf 'losangelex app-server at %s is not ready; existing pid %s is still running\n' \
        "$websocket_url" "$existing_pid" >&2
    fi
  fi

  local command
  if [[ -x "$binary_path" ]]; then
    command=("$binary_path" app-server --listen "$websocket_url")
  else
    command=(cargo +stable run -p codex-cli --bin codex -- app-server --listen "$websocket_url")
  fi

  (
    cd "$repo_root"
    setsid nohup "${command[@]}" </dev/null >>"$generation_log_file" 2>&1 &
    echo $! >"$generation_pid_file"
  )

  local deadline=$((SECONDS + start_timeout))
  while (( SECONDS < deadline )); do
    if app_server_ready "$websocket_url"; then
      write_app_server_state \
        "$generation_metadata_file" \
        "$build_id" \
        "$websocket_url" \
        "$generation_pid_file" \
        "$generation_log_file"
      write_app_server_state \
        "$app_server_state_file" \
        "$build_id" \
        "$websocket_url" \
        "$generation_pid_file" \
        "$generation_log_file"
      printf '%s\n' "$websocket_url"
      return 0
    fi
    sleep 1
  done

  printf 'losangelex failed to start local app-server at %s; see %s\n' \
    "$websocket_url" "$generation_log_file" >&2
  return 1
}

primary_room="${HOLLYWOOD_ROOM:-}"
observed_rooms="${HOLLYWOOD_OBSERVED_ROOMS:-}"
wake_rooms="${HOLLYWOOD_WAKE_ROOMS:-}"

if [[ -z "${primary_room}" && -z "${observed_rooms}" && -z "${wake_rooms}" && -f "$workspace_setup_file" ]]; then
  mapfile -t persisted_setup < <(load_persisted_workspace_setup "$workspace_setup_file" "$launch_cwd")
  if [[ ${#persisted_setup[@]} -ge 1 && -n "${persisted_setup[0]}" ]]; then
    primary_room="${persisted_setup[0]}"
    observed_rooms="${persisted_setup[1]:-}"
    wake_rooms="${persisted_setup[2]:-}"
  fi
fi

if [[ -z "${primary_room}" ]]; then
  primary_room="$(default_primary_room "$launch_cwd")"
fi

if [[ "$primary_room" != "main" ]]; then
  if [[ -z "$observed_rooms" ]]; then
    observed_rooms="main"
  fi
  if [[ -z "$wake_rooms" ]]; then
    wake_rooms="${primary_room}"
  fi
else
  if [[ -z "$wake_rooms" ]]; then
    wake_rooms="main"
  fi
fi

export HOLLYWOOD_AUTO_ATTACH="${HOLLYWOOD_AUTO_ATTACH:-1}"
export HOLLYWOOD_URL="${HOLLYWOOD_URL:-http://127.0.0.1:8765}"
export HOLLYWOOD_ROOM="$primary_room"
export HOLLYWOOD_OBSERVED_ROOMS="$observed_rooms"
export HOLLYWOOD_WAKE_ROOMS="$wake_rooms"
export HOLLYWOOD_ATTENTION_MODE="${HOLLYWOOD_ATTENTION_MODE:-focused}"
export LOSANGELEX_CLIENT_NAME="${LOSANGELEX_CLIENT_NAME:-losangelex-tui}"
export LOSANGELEX_PRODUCT_NAME="${LOSANGELEX_PRODUCT_NAME:-losangelex}"
export LOSANGELEX_RESTART_HANDOFF_FILE="$restart_handoff_file"

extra_args=()
has_explicit_cwd=0
has_explicit_sandbox=0
has_explicit_approval=0
has_explicit_full_bypass=0
prev_arg=""
for arg in "$@"; do
  if [[ "$prev_arg" == "--cd" || "$prev_arg" == "-C" ]]; then
    has_explicit_cwd=1
  elif [[ "$prev_arg" == "--sandbox" ]]; then
    has_explicit_sandbox=1
  elif [[ "$prev_arg" == "--ask-for-approval" ]]; then
    has_explicit_approval=1
  fi
  case "$arg" in
    --cd=*|-C=*)
      has_explicit_cwd=1
      ;;
    --sandbox=*)
      has_explicit_sandbox=1
      ;;
    --ask-for-approval=*)
      has_explicit_approval=1
      ;;
    --dangerously-bypass-approvals-and-sandbox)
      has_explicit_full_bypass=1
      ;;
  esac
  prev_arg="$arg"
done

if [[ $has_explicit_cwd -eq 0 ]]; then
  extra_args=(--cd "$launch_cwd")
fi

if [[ $has_explicit_sandbox -eq 0 && $has_explicit_full_bypass -eq 0 ]]; then
  extra_args+=(--sandbox danger-full-access)
fi

if [[ $has_explicit_approval -eq 0 && $has_explicit_full_bypass -eq 0 ]]; then
  extra_args+=(--ask-for-approval never)
fi

if [[ ! -f "$migration_marker" ]]; then
  mkdir -p "$migration_dir"
  existing_state=0
  for path in \
    "$codex_home/auth.json" \
    "$codex_home/config.toml" \
    "$codex_home/state_5.sqlite" \
    "$codex_home/sessions"
  do
    if [[ -e "$path" ]]; then
      existing_state=1
      break
    fi
  done

  cat >"$migration_marker" <<JSON
{
  "schema_version": 1,
  "created_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "codex_home": "$codex_home",
  "launch_cwd": "$launch_cwd",
  "reused_existing_codex_state": $existing_state,
  "hollywood": {
    "auto_attach": "${HOLLYWOOD_AUTO_ATTACH}",
    "url": "${HOLLYWOOD_URL}",
    "room": "${HOLLYWOOD_ROOM}",
    "observed_rooms": "${HOLLYWOOD_OBSERVED_ROOMS}",
    "wake_rooms": "${HOLLYWOOD_WAKE_ROOMS}",
    "attention_mode": "${HOLLYWOOD_ATTENTION_MODE}"
  }
}
JSON

  export LOSANGELEX_FIRST_RUN_MIGRATION=1
  if [[ $existing_state -eq 1 ]]; then
    printf '%s\n' \
      "losangelex first run: reusing CODEX_HOME at $codex_home" \
      "Hollywood auto-attach defaults to primary room ${HOLLYWOOD_ROOM} with observed rooms [${HOLLYWOOD_OBSERVED_ROOMS}] and wake rooms [${HOLLYWOOD_WAKE_ROOMS}]" >&2
  else
    printf '%s\n' \
      "losangelex first run: initialized at $codex_home" \
      "Hollywood auto-attach defaults to primary room ${HOLLYWOOD_ROOM} with observed rooms [${HOLLYWOOD_OBSERVED_ROOMS}] and wake rooms [${HOLLYWOOD_WAKE_ROOMS}]" >&2
  fi
fi

ensure_losangelex_binary

if [[ "$app_server_mode" == "daemon" || $is_team_command -eq 1 ]]; then
  if [[ -z "$app_server_url" ]]; then
    if [[ $is_team_command -eq 1 ]]; then
      current_app_server_url="$(read_app_server_json_websocket_url "$app_server_state_file")"
      if [[ -n "$current_app_server_url" ]] && app_server_ready "$current_app_server_url"; then
        app_server_url="$current_app_server_url"
      fi
    fi
    if [[ -z "$app_server_url" ]]; then
      app_server_url="$(start_losangelex_app_server "$app_server_start_timeout_seconds")"
    fi
  fi
  export LOSANGELEX_APP_SERVER_STATE_FILE="$app_server_state_file"
  export LOSANGELEX_APP_SERVER_URL="$app_server_url"
  if [[ "$app_server_mode" == "daemon" ]]; then
    extra_args+=(--remote "$app_server_url")
  fi
fi

if [[ $is_team_command -eq 1 ]]; then
  shift
  team_args=(
    --app-server-url "$app_server_url"
    --workspace "$launch_cwd"
    --hollywood-url "$HOLLYWOOD_URL"
    --room "$HOLLYWOOD_ROOM"
    --attention-mode "$HOLLYWOOD_ATTENTION_MODE"
  )
  if [[ -n "$HOLLYWOOD_OBSERVED_ROOMS" ]]; then
    team_args+=(--observed-rooms "$HOLLYWOOD_OBSERVED_ROOMS")
  fi
  if [[ -n "$HOLLYWOOD_WAKE_ROOMS" ]]; then
    team_args+=(--wake-rooms "$HOLLYWOOD_WAKE_ROOMS")
  fi
  exec python3 "$script_dir/losangelex_team.py" "${team_args[@]}" "$@"
fi

run_args=("$@")
while true; do
  rm -f "$restart_handoff_file"
  set +e
  "$binary_path" --enable tui_app_server "${extra_args[@]}" "${run_args[@]}"
  exit_code=$?
  set -e

  if [[ "$exit_code" == "$restart_exit_code" ]]; then
    restart_thread_id="$(read_restart_handoff_thread_id "$restart_handoff_file")"
    if [[ -n "$restart_thread_id" ]]; then
      rm -f "$restart_handoff_file"
      run_args=(resume "$restart_thread_id")
      continue
    fi
  fi

  exit "$exit_code"
done
