{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ContextRefillPurpose": {
      "enum": [
        "reader",
        "writer",
        "responder"
      ],
      "type": "string"
    },
    "ContextWindowRefillPhase": {
      "enum": [
        "preTurn",
        "midTurn",
        "postTurn"
      ],
      "type": "string"
    },
    "ContextWindowRefillReason": {
      "oneOf": [
        {
          "enum": [
            "contextLimit",
            "modelDownshift",
            "compHashChanged"
          ],
          "type": "string"
        },
        {
          "description": "Explicit native maintenance, not a provider or context-limit event.",
          "enum": [
            "explicitRequest"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "Owner-bound request at a drained automatic window boundary.",
  "properties": {
    "contextId": {
      "type": "string"
    },
    "historyVersion": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "operationId": {
      "type": "string"
    },
    "phase": {
      "$ref": "#/definitions/ContextWindowRefillPhase"
    },
    "purpose": {
      "$ref": "#/definitions/ContextRefillPurpose"
    },
    "reason": {
      "$ref": "#/definitions/ContextWindowRefillReason"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    },
    "windowId": {
      "type": "string"
    }
  },
  "required": [
    "contextId",
    "historyVersion",
    "operationId",
    "phase",
    "purpose",
    "reason",
    "threadId",
    "turnId",
    "windowId"
  ],
  "title": "ContextWindowRefillParams",
  "type": "object"
}